# Copy to .env only for local development; set Railway Variables in production.
# Generate a random persistent secret of at least 32 characters. Never commit it.
STUDY_SECRET_KEY=
# Railway: attach a Volume mounted at /data and set this to /data.
# Local: leave empty/unset to use .study-data (remove this line if empty).
# STUDY_DATA_DIR=/data
# Set 1 behind Railway HTTPS, 0 only for local HTTP.
STUDY_COOKIE_SECURE=0

# OpenAI-compatible API root ending in /v1. No provider is preselected.
STUDY_LLM_BASE_URL=
STUDY_LLM_API_KEY=
STUDY_LLM_MODEL=
# Output budget (1000-200000). Reasoning models like MiniMax-M3 need a large
# budget because chain-of-thought and the final answer share the same field.
STUDY_LLM_MAX_TOKENS=16000
# Enable only when the configured model supports response_format=json_object.
STUDY_LLM_JSON_MODE=0
# Optional fallback LLM used when the primary fails (outage, quota, invalid
# output). Same OpenAI-compatible contract; streaming switches providers only
# before the first visible delta.
STUDY_LLM_FALLBACK_BASE_URL=
STUDY_LLM_FALLBACK_API_KEY=
STUDY_LLM_FALLBACK_MODEL=

# Optional BGE-compatible embeddings. Reindex books after changing the model.
# Point STUDY_EMBED_BASE_URL to any OpenAI-compatible embeddings endpoint:
# a local server (http://127.0.0.1:<port>) or a hosted one (must be HTTPS).
# Without embeddings, the UI explicitly labels lexical + FTS5 retrieval.
STUDY_EMBED_BASE_URL=
STUDY_EMBED_API_KEY=
STUDY_EMBED_MODEL=bge-large-zh

# For a small class, set a strong invite code BEFORE opening registration.
STUDY_REGISTRATION_OPEN=1
STUDY_INVITE_CODE=
STUDY_MAX_USERS=100
STUDY_MAX_BOOKS=20
